APP_NAME=angisflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
#
# SQLite in development, MySQL in production. The schema runs on both
# unmodified — the only MySQL-specific work is the event-table partitioning
# migration, which checks the driver and skips itself elsewhere.
#
# At the read volumes this is built for, production wants a read replica too:
# set DB_READ_HOST and SELECTs are routed to it automatically. See
# config/database.php.

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=prism
# DB_USERNAME=prism
# DB_PASSWORD=
# DB_READ_HOST=

# ── Session, cache, queue ────────────────────────────────────────────────────
#
# Database drivers are fine on one server and become the bottleneck on several:
# every request writes the session, so a database-backed session table is the
# busiest table in the system. Redis turns that into an in-memory set.
#
# Production: SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────────────────
#
# 'log' writes every message to the log instead of sending it, which is what
# you want locally: password reset and verification links are readable without
# a mail server, and without the risk of mailing a real address by accident.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@prism.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Passkeys (WebAuthn) ──────────────────────────────────────────────────────
#
# The relying party id must be the registered domain with no scheme and no port
# — "prism.app", not "https://prism.app:443". A passkey registered against the
# wrong value cannot be used and cannot be repaired; it has to be deleted and
# made again. Left blank, it is derived from APP_URL.

WEBAUTHN_ID=
WEBAUTHN_NAME="${APP_NAME}"

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
#
# Leave both blank to disable. With no keys the widget is not rendered and the
# server-side check is skipped entirely, so the auth forms behave exactly as if
# it had never been added.

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Assistant ────────────────────────────────────────────────────────────────
#
# Answers questions about the tool from inside the search box. Left blank, the
# affordance is not shown at all — the key is what switches the feature on.
# Get one at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
# Questions per account per minute. A model call is the most expensive request
# this application makes, so it is bounded per subscriber.
ASSISTANT_RATE_LIMIT=10

# ── Security ─────────────────────────────────────────────────────────────────

BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"
